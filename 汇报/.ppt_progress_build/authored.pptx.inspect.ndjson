{"kind":"textbox","id":"sh/ts7md4r2","slideIndex":0,"position":{"left":60,"top":397,"width":1140,"height":90},"name":"矩形 5","text":"理解SS与语义anchor的含义，明确约束如何作用于训练；\n实现损失与训练接入，并设计实验。","geometry":"rect","lineWidth":0,"style":{"fontSize":27,"typeface":"Hiragino Sans GB","color":"#142C3E","alignment":"left"}}
{"kind":"textbox","id":"sh/sryl4zqx","slideIndex":0,"position":{"left":60,"top":508,"width":1140,"height":44},"name":"矩形 6","text":"当前阶段","geometry":"rect","lineWidth":0,"style":{"fontSize":30,"typeface":"Hiragino Sans GB","color":"#007F82","bold":true,"alignment":"left"}}
